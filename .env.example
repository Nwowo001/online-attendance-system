# MongoDB Connection URI
# For local dev: mongodb://localhost:27017/attendance-dev
# For Atlas dev: mongodb+srv://<user>:<password>@cluster.mongodb.net/attendance-dev?retryWrites=true&w=majority
# For Atlas prod: mongodb+srv://<user>:<password>@cluster.mongodb.net/attendance-prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/attendance-dev
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=your-nextauth-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development
ADMIN_SECRET_KEY=your-admin-secret-key-for-registration